#: proenergia/datasets/models.py:150
msgid "filter fields"
msgstr "campos de filtro"

#: proenergia/datasets/models.py:153
msgid ""
"A list containing JSON objects following this structure: {\"label\": \"Field "
"label\", \"description\": \"Field description\", \"column\": \"File/Database "
"column name\"}"
msgstr ""
"Uma lista contendo objetos JSON seguindo esta estrutura: {\"label\": \"Field "
"label\", \"description\": \"Field description\", \"column\": \"File/Database "
"column name\"}"

#: proenergia/datasets/models.py:157
msgid "popup fields"
msgstr "campos de popup"

#: proenergia/datasets/models.py:160
msgid ""
"A list containing JSON objects following this structure: {\"label\": \"Field "
"label\", \"description\": \"Field description\", \"column\": \"File/Database "
"column name\", \"unit\": \"Unit of measurement\"}"
msgstr ""
"Uma lista contendo objetos JSON seguindo esta estrutura: {\"label\": \"Field "
"label\", \"description\": \"Field description\", \"column\": \"File/Database "
"column name\", \"unit\": \"Unit of measurement\"}"

#: proenergia/datasets/models.py:164
msgid "summary fields"
msgstr "campos de resumo"

#: proenergia/datasets/models.py:166
msgid ""
"A list containing JSON objects following this structure:<br>\n"
"            {\"label\": \"Field label\", \"description\": \"Field "
"description\", \"columns\": [\"column_1\", \"column_2\"], \"unit\": \"Unit "
"of measurement (optional)\", \"method\": \"One of: sum, average, count, min, "
"max\", \"group_by\": \"column to aggregate data (optional)\", \"category\": "
"\"The category where the field will be shown in the frontend summary section "
"(optional)\", \"chartType\": \"One of: bar, donut, stacked, column, area, "
"highlight (optional)\", \"hasDecimal\": false}\n"
"            <br>The \"method\" field is optional and defaults to \"sum\". "
"The \"hasDecimal\" field is optional and defaults to false.\n"
"        "
msgstr ""
"Uma lista contendo objetos JSON seguindo esta estrutura:<br>\n"
"            {\"label\": \"Field label\", \"description\": \"Field "
"description\", \"columns\": [\"column_1\", \"column_2\"], \"unit\": \"Unit "
"of measurement (optional)\", \"method\": \"One of: sum, average, count, min, "
"max\", \"group_by\": \"column to aggregate data (optional)\", \"category\": "
"\"The category where the field will be shown in the frontend summary section "
"(optional)\", \"chartType\": \"One of: bar, donut, stacked, column, area, "
"highlight (optional)\", \"hasDecimal\": false}\n"
"            <br>O campo \"method\" é opcional e assume o valor \"sum\" por "
"padrão. O campo \"hasDecimal\" é opcional e assume o valor false por "
"padrão.\n"
"        "

#: proenergia/datasets/models.py:172
msgid "metric field types"
msgstr "tipos de campo métrico"

#: proenergia/datasets/models.py:175
msgid ""
"Mapping of field names to their data types for metrics extraction. "
"Structure: {'field_name': 'numeric', 'field_name_2': 'string'}. This is "
"automatically populated from data introspection."
msgstr ""
"Mapeamento de nomes de campos para seus tipos de dados para extração de "
"métricas. Estrutura: {'field_name': 'numeric', 'field_name_2': 'string'}. "
"Este é automaticamente preenchido a partir da introspeção de dados."

#: proenergia/datasets/models.py:179
msgid "visualization column"
msgstr "coluna de visualização"

#: proenergia/datasets/models.py:182
msgid ""
"Column on the model results data file whose values will be used to define "
"the data-driven visualization style."
msgstr ""
"Coluna nos resultados do modelo, cujos valores serão usados para definir o "
"estilo de visualização baseado em dados."

#: proenergia/datasets/models.py:188
msgid "color coding"
msgstr "codificação de cores"

#: proenergia/datasets/models.py:191
msgid ""
"A list containing JSON objects following this structure: {\"value\": "
"\"visualization column value\", \"color\": \"#000000\"}"
msgstr ""
"Uma lista contendo objetos JSON seguindo esta estrutura: {\"value\": \"valor "
"da coluna de visualização\", \"color\": \"#000000\"}"

#: proenergia/datasets/models.py:196
msgid "contextual layers"
msgstr "camadas contextuais"

#: proenergia/datasets/models.py:201
msgid "Vector datasets that can be visualized together with the model data."
msgstr ""
"Conjuntos de dados vetoriais que podem ser visualizados em conjunto com os "
"dados do modelo."

