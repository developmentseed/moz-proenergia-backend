#: proenergia/datasets/admin.py:170 proenergia/datasets/admin.py:413
msgid "Files in created or processing state cannot be reprocessed."
msgstr ""
"Arquivos com status 'Criado ou 'Em Processamento' não podem ser "
"reprocessados."

#: proenergia/datasets/admin.py:243
msgid "Content should be a list."
msgstr "Conteúdo deve ser uma lista."

#: proenergia/datasets/admin.py:252 proenergia/datasets/admin.py:265
#: proenergia/datasets/admin.py:278 proenergia/datasets/admin.py:333
msgid "Missing a required key."
msgstr "Falta um campo obrigatório."

#: proenergia/datasets/admin.py:256 proenergia/datasets/admin.py:269
#: proenergia/datasets/admin.py:328
msgid "Content should be a list"
msgstr "Conteúdo deve ser uma lista."

#: proenergia/datasets/admin.py:283
msgid "The value for the columns key should be a list."
msgstr "O valor para o campo columns deve ser uma lista."

#: proenergia/datasets/admin.py:296
msgid ""
"The value for the methods key should be sum, count, average, min or max."
msgstr "O valor para o campo methods deve ser sum, count, average, min ou max."

#: proenergia/datasets/admin.py:311
msgid ""
"The value for the chartType key should be bar, donut, stacked, column, area "
"or highlight."
msgstr ""
"O valor para o campo chartType deve ser bar, donut, stacked, column, area ou "
"highlight."

#: proenergia/datasets/admin.py:322
msgid ""
"The value for the hasDecimal key should be true or false. If not specified, "
"it's assumed to be false."
msgstr ""
"O valor para o campo hasDecimal deve ser true ou false. Se não especificado, "
"é assumido que seja false."

#: proenergia/datasets/admin.py:342
msgid "The value for the color key should be a valid hex color code."
msgstr ""
"O valor para o campo color deve ser um código hexadecimal de cor válido."

#: proenergia/datasets/admin.py:404
#, python-format
msgid "{%(count)d file queued for reprocessing."
msgid_plural "{%(count)d files queued for reprocessing."
msgstr[0] "{%(count)d arquivo enviado para reprocessamento."
msgstr[1] "{%(count)d arquivos enviados para reprocessamento."

