[Unit]
Description=ProEnergia Django Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=proenergia
Group=proenergia
WorkingDirectory=/var/www/proenergia/app
Environment=PATH=/var/www/proenergia/app/venv/bin
Environment=DJANGO_SETTINGS_MODULE=proenergia.config.production
Environment=DJANGO_CONFIGURATION=Production
EnvironmentFile=/var/www/proenergia/app/.env
ExecStart=/var/www/proenergia/app/venv/bin/gunicorn \
    --config /etc/gunicorn/gunicorn.conf.py \
    proenergia.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/proenergia /var/log/proenergia /var/run/proenergia

# Resource limits
LimitNOFILE=65536
MemoryHigh=8G
MemoryMax=10G

[Install]
WantedBy=multi-user.target