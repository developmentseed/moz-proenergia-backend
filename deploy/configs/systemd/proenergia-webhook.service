[Unit]
Description=ProEnergia GitHub Webhook Listener
After=network.target
Wants=network.target

[Service]
Type=simple
User=proenergia
Group=proenergia
WorkingDirectory=/var/www/proenergia/webhook
Environment="WEBHOOK_SECRET=CHANGE_ME_TO_SECURE_SECRET"
ExecStart=/usr/bin/python3 /var/www/proenergia/webhook/webhook_listener.py
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/proenergia

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target