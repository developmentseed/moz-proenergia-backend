# ProEnergia deployment sudoers configuration
# This file should be placed in /etc/sudoers.d/proenergia-deploy
# Allows ubuntu user to run deployment script without password

# Allow ubuntu user to run the deployment wrapper
ubuntu ALL=(root) NOPASSWD: /usr/local/bin/deploy-proenergia

# Allow proenergia user to run the deployment wrapper (needed for webhook)
proenergia ALL=(root) NOPASSWD: /usr/local/bin/deploy-proenergia

# Allow proenergia user to check service status (read-only operations)
proenergia ALL=(root) NOPASSWD: /bin/systemctl is-active proenergia
proenergia ALL=(root) NOPASSWD: /bin/systemctl status proenergia

# If you want to allow proenergia to restart only its own service (alternative approach)
# Uncomment the following line and use it in a modified update_app.sh:
# proenergia ALL=(root) NOPASSWD: /bin/systemctl restart proenergia